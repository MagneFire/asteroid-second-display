[Unit]
Description=Sync the second display time
Requires=asteroid-seconddisplayd.service
After=asteroid-seconddisplayd.service

[Service]
Type=oneshot
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/asteroid-seconddisplay --sync-time
