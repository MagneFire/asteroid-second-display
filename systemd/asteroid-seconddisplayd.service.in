[Unit]
Description=AsteroidOS second display daemon

[Service]
Type=dbus
BusName=org.asteroid.SecondDisplay
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/asteroid-seconddisplayd
Restart=on-failure

[Install]
WantedBy=default.target
