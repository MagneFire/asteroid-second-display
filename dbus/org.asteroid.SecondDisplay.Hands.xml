<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.asteroid.SecondDisplay.Hands">
    <property name="WatchMode" type="b" access="read"/>
    <method name="ResumeWatchMode">
      <arg name="ok" type="b" direction="out"/>
    </method>
    <method name="MoveHand">
      <arg name="hand" type="i" direction="in"/>
      <arg name="position" type="i" direction="in"/>
      <arg name="ok" type="b" direction="out"/>
    </method>
    <method name="MoveAllHands">
      <arg name="positions" type="ai" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In0" value="QList&lt;int&gt;"/>
      <arg name="ok" type="b" direction="out"/>
    </method>
    <method name="Calibrate">
      <arg name="hand" type="i" direction="in"/>
      <arg name="rotation" type="i" direction="in"/>
      <arg name="steps" type="i" direction="in"/>
      <arg name="ok" type="b" direction="out"/>
    </method>
  </interface>
</node>
