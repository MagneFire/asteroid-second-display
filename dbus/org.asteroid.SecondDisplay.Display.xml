<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.asteroid.SecondDisplay.Display">
    <property name="Capabilities" type="u" access="read"/>
    <property name="StepCounterEnabled" type="b" access="readwrite"/>
    <property name="HeartRateEnabled" type="b" access="readwrite"/>
    <property name="MotionEnabled" type="b" access="readwrite"/>
    <property name="DisplayColor" type="i" access="readwrite"/>
    <property name="AodOffloadEnabled" type="b" access="readwrite"/>
    <property name="AodOffloadActive" type="b" access="read"/>
    <method name="ReleaseAodOffload">
      <arg name="ok" type="b" direction="out"/>
    </method>
    <method name="SynchronizeTime">
      <arg name="ok" type="b" direction="out"/>
    </method>
    <method name="EnterTimepieceMode">
      <arg name="powerOff" type="b" direction="in"/>
      <arg name="ok" type="b" direction="out"/>
    </method>
  </interface>
</node>
